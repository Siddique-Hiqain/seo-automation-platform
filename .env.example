# Copy to .env and fill in. Read at runtime by docker-compose (NOT baked into the image).
# Pydantic matches these case-insensitively to the backend settings.

# --- Database (your existing sPanel MySQL) ---
# If MySQL runs on the VPS host, use host.docker.internal as the host (mapped in
# docker-compose.yml). MySQL must listen on the docker bridge/host gateway for this to
# work — if it is bound to 127.0.0.1 only, either add the bridge to bind-address, or
# create a MySQL user allowed from the container subnet, or mount the MySQL socket.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@host.docker.internal:3306/DBNAME

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free

# --- Keyword data (DataForSEO) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- WordPress credential encryption ---
# Generate once and keep it stable (changing it makes stored WP credentials unreadable):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORDPRESS_CREDENTIALS_KEY=

# --- Runtime ---
APP_ENV=production
APP_DEBUG=false
# Set to false to skip `alembic upgrade head` on container start (default: true).
# RUN_MIGRATIONS=true
